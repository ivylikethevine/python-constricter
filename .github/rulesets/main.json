{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Lint"
          },
          {
            "context": "Docs"
          },
          {
            "context": "Action"
          },
          {
            "context": "Test (ubuntu-latest, 3.11)"
          },
          {
            "context": "Test (ubuntu-latest, 3.12)"
          },
          {
            "context": "Test (ubuntu-latest, 3.13)"
          },
          {
            "context": "Test (ubuntu-latest, 3.14)"
          },
          {
            "context": "Test (macos-latest, 3.11)"
          },
          {
            "context": "Test (macos-latest, 3.12)"
          },
          {
            "context": "Test (macos-latest, 3.13)"
          },
          {
            "context": "Test (macos-latest, 3.14)"
          },
          {
            "context": "Test (windows-latest, 3.11)"
          },
          {
            "context": "Test (windows-latest, 3.12)"
          },
          {
            "context": "Test (windows-latest, 3.13)"
          },
          {
            "context": "Test (windows-latest, 3.14)"
          },
          {
            "context": "Test (ubuntu-latest, pypy3.11)"
          },
          {
            "context": "Test (ubuntu-latest, 3.14t)"
          },
          {
            "context": "Build"
          },
          {
            "context": "CodeQL (python)"
          },
          {
            "context": "CodeQL (actions)"
          },
          {
            "context": "Workflow audit"
          },
          {
            "context": "Dependency audit"
          },
          {
            "context": "Dependency review"
          },
          {
            "context": "Secrets"
          }
        ]
      }
    }
  ]
}
