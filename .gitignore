# Everything generated locally (the dev venv, tool caches, coverage data, build output) lives under local/.
local/

# Written next to the sources by Python.
__pycache__/

# Generated by a build (hatch_build.py, or `python -m stdlib_tables`): the standard-library tables, and
# the tests' list of what only some platforms and Pythons have.
constricter/fix/tables/
stdlib_tables/partial.json

# npm installs of the pinned CI Markdown tools (.github/package.json)
.github/node_modules/

.hypothesis

# Claude Code's agent worktrees: other checkouts of this repository.
.claude/worktrees/

# Claude Code's sandbox bind-mounts /dev/null over these denied paths while a
# session runs; none is a file of this repo
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.zprofile
/.zshrc
/.claude/agents
/.claude/commands
/.claude/hooks
/.claude/launch.json
/.claude/loop.md
/.claude/output-styles
/.claude/routines
/.claude/scheduled_tasks.json
/.claude/settings.json
/.claude/settings.local.json
/.claude/skills
/.claude/workflows
/.claude/.cc-writes

# Backups merge tools leave next to a conflicted file.
*.orig
